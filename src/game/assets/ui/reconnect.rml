<rml>
<head>
    <title>[[reconnect.window_title]]</title>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<!-- Shown over any scene while a dropped connection is being resumed. The
     scrim spans the window so nothing behind it can be clicked. -->
<body class="screen-center reconnect-screen">
    <div class="card reconnect-card" data-model="reconnect">
        <div class="title">[[reconnect.title]]</div>

        <div class="status status-info">[[reconnect.message]] {{ seconds_left }}[[reconnect.seconds_short]]</div>

        <div class="btn-secondary" data-event-click="logout">[[reconnect.log_out]]</div>
    </div>
</body>
</rml>
