<rml>
<head>
    <title>Vitals</title>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body class="vitals-screen">
    <div data-model="vitals" class="vitals-root">
        <div class="vitals-panel">
            <div class="vitals-row">
                <span class="vitals-level">Lv {{ level }}</span>
                <span class="vitals-value">{{ health }}</span>
            </div>
            <div class="char-bar vitals-bar"><div class="char-bar-fill char-bar-health" data-style-width="health_percent"></div></div>
            <div class="char-bar vitals-bar vitals-bar-thin"><div class="char-bar-fill char-bar-exp" data-style-width="experience_percent"></div></div>
        </div>
        <div class="vitals-safe-zone" data-if="is_safe">Safe Zone</div>
        <div class="vitals-notice" data-if="notice != ''">{{ notice }}</div>
        <div class="vitals-death" data-if="is_dead">
            <div class="vitals-death-title">You died</div>
            <div class="vitals-death-timer">Respawning in {{ respawn }}</div>
        </div>
    </div>
</body>
</rml>
