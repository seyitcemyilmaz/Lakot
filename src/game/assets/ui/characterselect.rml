<rml>
<head>
    <title>[[characterselect.window_title]]</title>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<!--
    data-model lives on the .card wrapper, NOT on <body> - a data-model on
    <body> breaks data-for in RmlUi 6.1 (fixed upstream in 6.2, PR #790), and
    the character list below is a data-for. Same reason chat.rml is structured
    this way.

    The screen has exactly two modes, and each is ONE wrapper div that toggles
    as a unit rather than a handful of siblings toggling individually. That is
    partly clarity and partly the RmlUi 6.1 layout bug documented in
    login.rml: several data-if siblings changing in the same update, with a
    multi-child static block staying visible through it, can permanently
    corrupt the card's width. Two mutually exclusive wrappers keep each update
    to a single pair of toggles.
-->
<body class="screen-center">
    <div class="card" data-model="character_select">
        <div class="title">[[characterselect.title]]</div>
        <div class="char-slots" data-if="has_kingdom">{{ kingdom_label }}</div>

        <!-- ===== Mode 1: pick an existing character ===== -->
        <div data-if="!is_creating &amp;&amp; !is_deleting">
            <div class="char-slots">{{ slots_label }}</div>

            <div class="char-list">
                <div class="char-row" data-for="character : characters"
                     data-class-is-selected="character.is_selected"
                     data-event-click="select(character.index)">
                    <div class="char-name">{{ character.name }}</div>
                    <div class="char-meta">{{ character.meta_text }}</div>
                </div>

                <div class="char-empty" data-if="!has_characters">[[characterselect.no_characters]]</div>
            </div>

            <div class="status" data-class-status-error="is_error" data-class-status-info="!is_error">{{ status_message }}</div>

            <div class="btn-primary" data-class-is-busy="is_busy || !has_selection"
                 data-event-click="enter_world">[[characterselect.enter_world]]</div>

            <div class="btn-secondary" data-if="has_free_slot" data-event-click="begin_create">[[characterselect.create_new]]</div>

            <div class="btn-danger" data-class-is-disabled="is_busy || !has_selection"
                 data-event-click="begin_delete">[[characterselect.delete_character]]</div>

            <div class="link" data-event-click="logout">[[characterselect.log_out]]</div>
        </div>

        <!-- ===== Mode 3: confirm deleting the selected character ===== -->
        <div data-if="is_deleting">
            <div class="char-row is-selected">
                <div class="char-name">{{ delete_target_name }}</div>
                <div class="char-meta">{{ delete_target_meta }}</div>
            </div>

            <div class="field-label">[[characterselect.delete_prompt]]</div>
            <input type="text" class="field" data-value="delete_name_input"
                   data-event-keyup="delete_name_changed" data-event-keydown="delete_name_keydown"/>

            <div class="status" data-class-status-error="is_error" data-class-status-info="!is_error">{{ status_message }}</div>

            <div class="btn-primary" data-event-click="cancel_delete">[[characterselect.cancel]]</div>
            <div class="btn-danger" data-class-is-disabled="is_busy || !delete_name_matches"
                 data-event-click="confirm_delete">[[characterselect.delete]]</div>
        </div>

        <!-- ===== Mode 2: create a new character ===== -->
        <div data-if="is_creating">
            <!-- Only for an account's first character: the kingdom is chosen
                 once and every later character shares it. -->
            <div data-if="!has_kingdom">
                <div class="field-label">[[characterselect.choose_kingdom]]</div>

                <div class="char-row" data-for="kingdom : kingdoms"
                     data-class-is-selected="kingdom.is_selected"
                     data-event-click="choose_kingdom(kingdom.id)">
                    <div class="char-name" data-style-color="kingdom.color">{{ kingdom.name }}</div>
                    <div class="char-meta">{{ kingdom.description }}</div>
                </div>
            </div>

            <div class="field-label">[[characterselect.choose_class]]</div>

            <div class="char-row" data-for="cls : classes"
                 data-class-is-selected="cls.is_selected"
                 data-event-click="choose_class(cls.id)">
                <div class="char-name">{{ cls.name }}</div>
                <div class="char-meta">{{ cls.description }}</div>
            </div>

            <div class="field-label">[[characterselect.character_name]]</div>
            <input type="text" class="field" data-value="new_name" data-event-keydown="name_keydown"/>

            <div class="status" data-class-status-error="is_error" data-class-status-info="!is_error">{{ status_message }}</div>

            <div class="btn-primary" data-class-is-busy="is_busy || !has_class" data-event-click="confirm_create">[[characterselect.create]]</div>

            <div class="link" data-event-click="cancel_create">[[characterselect.back]]</div>
        </div>
    </div>
</body>
</rml>
