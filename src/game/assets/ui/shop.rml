<rml>
<head>
    <title>[[shop.window_title]]</title>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body class="shop-screen">
<div class="shop-root" data-model="shop">
    <div id="shop-window" class="shop-window">
        <div class="chat-titlebar" data-event-mousedown="drag_start">
            <div class="chat-tab">{{ title }}</div>
            <div class="chat-titlebar-buttons">
                <div class="chat-icon-btn" data-event-click="close">X</div>
            </div>
        </div>

        <div class="shop-gold">
            <div class="shop-gold-label">[[shop.gold]]</div>
            <div class="shop-gold-value">{{ gold_text }}</div>
        </div>

        <div class="shop-tabs">
            <div class="shop-tab" data-class-is-active="tab == 'buy'" data-event-click="set_tab('buy')">[[shop.tab_buy]]</div>
            <div class="shop-tab" data-class-is-active="tab == 'sell'" data-event-click="set_tab('sell')">[[shop.tab_sell]]</div>
        </div>

        <div class="shop-list" data-if="tab == 'buy'">
            <div class="shop-row" data-for="item : buy_items"
                 data-class-is-selected="item.is_selected"
                 data-class-is-restricted="!item.is_usable"
                 data-event-click="select_buy(item.template_id)">
                <div class="shop-icon"><img data-if="item.icon != ''" data-attr-src="item.icon" data-attr-style="item.icon_style"/></div>
                <div class="shop-info">
                    <div class="shop-name">{{ item.name }}</div>
                    <div class="shop-sub">{{ item.level_text }}</div>
                </div>
                <div class="shop-price" data-class-is-short="!item.is_affordable">{{ item.price_text }}</div>
            </div>
        </div>

        <div class="shop-list" data-if="tab == 'sell'">
            <div class="shop-empty" data-if="sell_items.size == 0">[[shop.sell_empty]]</div>
            <div class="shop-row" data-for="item : sell_items"
                 data-class-is-selected="item.is_pending"
                 data-event-click="sell(item.bag_slot)">
                <div class="shop-icon">
                    <img data-if="item.icon != ''" data-attr-src="item.icon" data-attr-style="item.icon_style"/>
                    <div class="inv-piece-count" data-if="item.count > 1">{{ item.count }}</div>
                </div>
                <div class="shop-info">
                    <div class="shop-name">{{ item.name }}</div>
                </div>
                <div class="shop-price">{{ item.price_text }}</div>
            </div>
        </div>

        <div class="shop-footer" data-if="tab == 'buy' &amp;&amp; selected_template_id != 0">
            <div class="shop-qty-row">
                <div class="shop-qty-label">[[shop.quantity]]</div>
                <div class="shop-qty-btn" data-event-click="quantity_down">-</div>
                <div class="shop-qty-value">{{ buy_quantity }}</div>
                <div class="shop-qty-btn" data-event-click="quantity_up">+</div>
                <div class="shop-total">{{ buy_total_text }}</div>
            </div>
            <div class="btn-primary" data-class-is-busy="!can_confirm_buy" data-event-click="confirm_buy">[[shop.button.buy]]</div>
        </div>

        <div class="shop-footer" data-if="tab == 'sell' &amp;&amp; pending_sell_slot >= 0">
            <div class="shop-confirm-text">[[shop.sell_confirm]]</div>
            <div class="shop-confirm-row">
                <div class="btn-primary shop-confirm-btn" data-event-click="confirm_sell">[[shop.button.sell]]</div>
                <div class="btn-secondary shop-confirm-btn" data-event-click="cancel_sell">[[shop.button.cancel]]</div>
            </div>
        </div>
    </div>
</div>
</body>
</rml>
